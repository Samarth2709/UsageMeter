{
  "name": "usage-meter",
  "version": "0.2.3",
  "private": true,
  "description": "Local Mac app for checking Codex and Claude usage limits.",
  "author": "Samarth Kumbla",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node server.js",
    "test": "node --test",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dist:mac": "bash scripts/dist-mac.sh"
  },
  "build": {
    "appId": "com.samarth.usagemeter",
    "productName": "Usage Meter",
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "UsageMeter-${arch}.dmg"
    },
    "files": [
      "assets/**",
      "public/**",
      "usage-history/**",
      "electron-main.js",
      "preload.js",
      "server.js",
      "usage-windows.js",
      "package.json"
    ]
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
